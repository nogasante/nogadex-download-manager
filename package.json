{
  "name": "hyper-downloader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:ui": "vite",
    "dev:engine": "tsx watch server/server.ts",
    "dev": "concurrently \"npm run dev:engine\" \"npm run dev:ui\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "tsx server/server.ts",
    "electron": "electron .",
    "desktop": "concurrently \"cross-env BROWSER=none vite\" \"wait-on tcp:5173 && electron .\"",
    "dist": "vite build && electron-builder --win",
    "test": "tsx server/test_runner.ts",
    "test:all": "tsx server/test_runner.ts",
    "test:correctness": "tsx server/test_correctness.ts",
    "test:integrity": "tsx server/test_integrity.ts",
    "test:scheduler": "tsx server/test_scheduler.ts",
    "test:network": "tsx server/test_network.ts",
    "test:optimization": "tsx server/test_optimization.ts",
    "test:adversarial": "tsx server/test_adversarial.ts",
    "test:real": "tsx server/test_real_server.ts",
    "test:security": "tsx server/test_security.ts",
    "test:soak": "tsx server/test_soak.ts",
    "benchmark": "tsx server/benchmark_engine.ts",
    "test:hardening": "tsx server/test_product_hardening.ts",
    "test:gate": "tsx server/test_release_gate.ts",
    "test:internet": "tsx server/test_real_internet.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "wait-on": "^9.1.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.hyperdownloader.app",
    "productName": "HyperDownloader",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}_Setup_${version}.${ext}"
    }
  }
}