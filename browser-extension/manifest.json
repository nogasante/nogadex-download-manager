{
  "manifest_version": 3,
  "name": "Nogadex Download Manager Integration",
  "version": "1.0.0",
  "description": "High-speed multi-threaded download takeover and media capture for Nogadex Download Manager.",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:5005/*",
    "http://localhost:5005/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Nogadex Download Manager"
  }
}
