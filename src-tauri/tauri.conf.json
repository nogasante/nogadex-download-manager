{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NDM",
  "version": "1.0.5",
  "identifier": "com.nogadex.ndm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NDM - Nogadex Download Manager",
        "url": "/",
        "width": 1100,
        "height": 720,
        "minWidth": 850,
        "minHeight": 550,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": ["sidecar/ndm-engine"]
  }
}
